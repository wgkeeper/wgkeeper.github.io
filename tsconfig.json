{
  // This file is not used in compilation. It is here for the editor and `pnpm typecheck`.
  // The options are @docusaurus/tsconfig's without "baseUrl", which TypeScript 7
  // removed; "paths" resolve against this file instead. Go back to
  // "extends": "@docusaurus/tsconfig" once it drops baseUrl.
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
